# ============================================
# Garage Connect 環境変数テンプレート
# ============================================
# このファイルを apps/web/.env.local にコピーして値を埋めてください
# （Next.js は monorepo では Next アプリ直下の .env.local を読み込みます）
# .env.local は .gitignore に含まれているため、コミットされません
#
# cp .env.example apps/web/.env.local
# ============================================


# ============================================
# Supabase
# ============================================
# プロジェクト URL（Supabase ダッシュボード → Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon Key（公開して OK な公開鍵）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service Role Key（絶対に公開しない・サーバー側のみで使用）
SUPABASE_SERVICE_ROLE_KEY=eyJhxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# LINE
# ============================================
# SaaS 全体共通の LIFF ID
NEXT_PUBLIC_LIFF_ID=2000000000-xxxxxxxx

# ※ 各テナント（車屋）の Channel Access Token / Channel Secret は
#   管理画面から登録され、DB に暗号化保存されます。
#   このファイルには記載しません。


# ============================================
# Stripe
# ============================================
# Publishable Key（公開して OK）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Secret Key（絶対に公開しない）
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Webhook Secret（Stripe Webhook の検証用）
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# サブスク Price ID（Stripe ダッシュボードで商品作成後に設定）
STRIPE_PRICE_STANDARD=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx


# ============================================
# 暗号化キー
# ============================================
# LINE Channel Token 等の機密情報を DB に暗号化保存するためのキー
# 生成方法: openssl rand -hex 32
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# 日次通知バッチ
# ============================================
# /api/cron/daily-notifications を保護するシークレット
# 生成方法: openssl rand -hex 24
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================
# アプリ設定
# ============================================
# 本番: https://app.garage-connect.jp（仮）
# 開発: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development


# ============================================
# AI / OCR（車検証 画像/PDF 読み取り）
# ============================================
# 車検証の画像/PDFを Gemini Vision で OCR して顧客・車両を自動入力する際に使用。
# 取得: https://aistudio.google.com/apikey （未設定なら OCR は無効・手入力にフォールバック）
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 使用モデル（任意・既定 gemini-2.5-flash）。404(モデル廃止)時はここで最新の Flash 系に切替
# GEMINI_MODEL=gemini-2.5-flash
